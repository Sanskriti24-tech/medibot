# =====================================================================
# Environment Variables - TEMPLATE
# =====================================================================
# Copy this file to ".env" and fill in real values.
# The .env file is git-ignored so secrets are never committed.
#
#   cp .env.example .env
# =====================================================================

# Which environment to run: development | testing | production
FLASK_ENV=development

# Secret key used by Flask for security. In production, set this to a
# long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key
